{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A base do monorepo é voltada a Node (NodeNext, types: node, sem DOM). Este
    // pacote roda no navegador e é empacotado pelo Vite, então o alvo de módulo e
    // as libs mudam — mas todas as flags de rigor da base permanecem (research R9).
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    // O build de produção é do Vite; aqui o tsc só verifica tipos.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist"]
}
