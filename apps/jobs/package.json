{
  "name": "@open-nav-charts/jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "open-nav-charts-jobs": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "prestart": "pnpm build",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@open-nav-charts/aisweb-client": "workspace:*",
    "@open-nav-charts/domain": "workspace:*",
    "@open-nav-charts/object-storage": "workspace:*",
    "commander": "^15.0.0",
    "p-limit": "^7.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@testcontainers/postgresql": "^11.14.0",
    "testcontainers": "^11.14.0"
  }
}
