# Credenciais da API AISWEB (DECEA). Solicitadas no portal do DECEA.
# Sem valor padrão: são segredos e nunca vão para o versionamento.
AISWEB_API_KEY=
AISWEB_API_PASS=

# PostgreSQL — aponta para o contêiner de docker-compose.yml
DATABASE_URL=postgres://onc:onc@localhost:5432/onc

# Bucket compatível com S3 — MinIO local de docker-compose.yml.
# Em produção (Railway): S3_ENDPOINT=https://storage.railway.app, S3_REGION=auto,
# S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=onc-charts
S3_FORCE_PATH_STYLE=true

# API REST — usada apenas por apps/api. Ambas têm padrão, então podem ficar
# ausentes; as credenciais da AISWEB não são lidas pela API.
API_PORT=3000
API_LOG_LEVEL=info
